# Copy to backend/.env for local development. Never commit the real .env.
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG is false (any long random string):
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Free key from developer.tomtom.com. Leave empty to use the OSRM demo server (car profile).
TOMTOM_API_KEY=
